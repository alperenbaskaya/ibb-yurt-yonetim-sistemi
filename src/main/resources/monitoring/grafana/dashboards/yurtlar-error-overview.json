  "panels": [
    {"id":1,"title":"Request Rate","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":0,"y":0},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[1m]))","legendFormat":"requests/s"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"options":{"colorMode":"value","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":2,"title":"HTTP Error Rate %","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":4,"y":0},"targets":[{"refId":"A","expr":"100 * sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[1m])), 0.001)"}],"fieldConfig":{"defaults":{"unit":"percent","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":5}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":3,"title":"5xx Rate","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":8,"y":0},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"5..\"}[1m]))"}],"fieldConfig":{"defaults":{"unit":"reqps","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":0.01}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":4,"title":"DLT Increase (5m)","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":12,"y":0},"targets":[{"refId":"A","expr":"sum(increase(yurtlar_kafka_dlt_total[5m]))"}],"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":5,"title":"Outbox Oldest Pending Age","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":16,"y":0},"targets":[{"refId":"A","expr":"max(yurtlar_outbox_oldest_pending_age_seconds)"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":30},{"color":"red","value":60}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":6,"title":"Elasticsearch Failures (5m)","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":4,"x":20,"y":0},"targets":[{"refId":"A","expr":"sum(increase({__name__=~\"yurtlar_elasticsearch_(index|search|reindex)_failure_total\"}[5m]))"}],"fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},

    {"id":10,"title":"HTTP Request Rate","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":0,"y":4},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[1m]))","legendFormat":"all"},{"refId":"B","expr":"sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"4..\"}[1m]))","legendFormat":"4xx"},{"refId":"C","expr":"sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"5..\"}[1m]))","legendFormat":"5xx"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":11,"title":"HTTP Error Percentage","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":8,"y":4},"targets":[{"refId":"A","expr":"100 * sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[1m])), 0.001)","legendFormat":"4xx + 5xx"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":12,"title":"HTTP Latency p95 / p99","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":16,"y":4},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"yurtlar-backend\"}[5m])))","legendFormat":"p95"},{"refId":"B","expr":"histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"yurtlar-backend\"}[5m])))","legendFormat":"p99"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":13,"title":"Top Failing URI Templates","type":"barchart","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":11},"targets":[{"refId":"A","expr":"topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"4..|5..\"}[5m])))","legendFormat":"{{uri}}","instant":true}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":14,"title":"Errors by Code","type":"barchart","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":11},"targets":[{"refId":"A","expr":"sum by (code) (increase(yurtlar_errors_total[5m]))","legendFormat":"{{code}}","instant":true}]},
    {"id":15,"title":"Errors by Category","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":0,"y":18},"targets":[{"refId":"A","expr":"sum by (category) (increase(yurtlar_errors_total[5m]))","legendFormat":"{{category}}"}]},
    {"id":16,"title":"Errors by Severity","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":8,"y":18},"targets":[{"refId":"A","expr":"sum by (severity) (increase(yurtlar_errors_total[5m]))","legendFormat":"{{severity}}"}]},
    {"id":17,"title":"Errors by Source","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":16,"y":18},"targets":[{"refId":"A","expr":"sum by (source) (increase(yurtlar_errors_total[5m]))","legendFormat":"{{source}}"}]},

    {"id":20,"title":"Kafka Consumer Lag","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":6,"x":0,"y":25},"targets":[{"refId":"A","expr":"sum by (consumergroup, topic) (kafka_consumergroup_lag)","legendFormat":"{{consumergroup}} / {{topic}}"}]},
    {"id":21,"title":"Kafka Processing Errors","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":6,"x":6,"y":25},"targets":[{"refId":"A","expr":"sum by (eventType, consumer) (increase(yurtlar_kafka_processing_errors_total[5m]))","legendFormat":"{{eventType}} / {{consumer}}"}]},
    {"id":22,"title":"Kafka DLT Activity","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":6,"x":12,"y":25},"targets":[{"refId":"A","expr":"sum by (eventType, consumer) (increase(yurtlar_kafka_dlt_total[5m]))","legendFormat":"{{eventType}} / {{consumer}}"}]},
    {"id":23,"title":"Kafka Duplicates","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":6,"x":18,"y":25},"targets":[{"refId":"A","expr":"sum by (eventType, consumer) (increase(yurtlar_kafka_duplicates_total[5m]))","legendFormat":"{{eventType}} / {{consumer}}"}]},

    {"id":30,"title":"Outbox Pending Count","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":0,"y":32},"targets":[{"refId":"A","expr":"yurtlar_outbox_pending_count","legendFormat":"pending"}]},
    {"id":31,"title":"Outbox Oldest Pending Age","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":8,"y":32},"targets":[{"refId":"A","expr":"yurtlar_outbox_oldest_pending_age_seconds","legendFormat":"oldest age"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":32,"title":"Outbox Publish Rate","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":16,"y":32},"targets":[{"refId":"A","expr":"sum(rate(yurtlar_outbox_publish_success_total[5m]))","legendFormat":"success"},{"refId":"B","expr":"sum(rate(yurtlar_outbox_publish_failure_total[5m]))","legendFormat":"failure"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}},

    {"id":40,"title":"Elasticsearch Index Operations","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":0,"y":39},"targets":[{"refId":"A","expr":"sum(rate(yurtlar_elasticsearch_index_success_total[5m]))","legendFormat":"success"},{"refId":"B","expr":"sum(rate(yurtlar_elasticsearch_index_failure_total[5m]))","legendFormat":"failure"}]},
    {"id":41,"title":"Elasticsearch Search Operations","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":8,"y":39},"targets":[{"refId":"A","expr":"sum(rate(yurtlar_elasticsearch_search_success_total[5m]))","legendFormat":"success"},{"refId":"B","expr":"sum(rate(yurtlar_elasticsearch_search_failure_total[5m]))","legendFormat":"failure"}]},
    {"id":42,"title":"Elasticsearch Reindex Operations","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":8,"x":16,"y":39},"targets":[{"refId":"A","expr":"sum(rate(yurtlar_elasticsearch_reindex_success_total[5m]))","legendFormat":"success"},{"refId":"B","expr":"sum(rate(yurtlar_elasticsearch_reindex_failure_total[5m]))","legendFormat":"failure"}]},

    {"id":50,"title":"Recent ERROR Logs","type":"logs","datasource":{"type":"loki","uid":"loki"},"gridPos":{"h":9,"w":12,"x":0,"y":46},"targets":[{"refId":"A","expr":"{service=\"yurtlar\", level=\"ERROR\"}","queryType":"range"}],"options":{"showTime":true,"showLabels":false,"wrapLogMessage":true,"enableLogDetails":true,"sortOrder":"Descending"}},
    {"id":51,"title":"WARN / ERROR Infrastructure Logs","type":"logs","datasource":{"type":"loki","uid":"loki"},"gridPos":{"h":9,"w":12,"x":12,"y":46},"targets":[{"refId":"A","expr":"{service=\"yurtlar\", level=~\"WARN|ERROR\", component=~\"KAFKA|OUTBOX|ELASTICSEARCH\"}","queryType":"range"}],"options":{"showTime":true,"showLabels":false,"wrapLogMessage":true,"enableLogDetails":true,"sortOrder":"Descending"}},

    {"id":60,"title":"Availability SLO Target","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":5,"w":8,"x":0,"y":55},"targets":[{"refId":"A","expr":"vector(99.5)","legendFormat":"target"}],"fieldConfig":{"defaults":{"unit":"percent","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":99.5}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":61,"title":"Current Availability (15m)","description":"Only 5xx responses consume availability. Expected 4xx outcomes are excluded from failures.","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":5,"w":8,"x":8,"y":55},"targets":[{"refId":"A","expr":"100 * (1 - sum(increase(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"5..\"}[15m])) / clamp_min(sum(increase(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[15m])), 1))"}],"fieldConfig":{"defaults":{"unit":"percent","decimals":3,"min":0,"max":100,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":99.5}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":62,"title":"Error Budget Remaining (15m)","description":"100% means none of the 0.5% failure budget was consumed; values are clamped at zero.","type":"gauge","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":5,"w":8,"x":16,"y":55},"targets":[{"refId":"A","expr":"clamp_min(100 * (1 - ((sum(increase(http_server_requests_seconds_count{job=\"yurtlar-backend\",status=~\"5..\"}[15m])) / clamp_min(sum(increase(http_server_requests_seconds_count{job=\"yurtlar-backend\"}[15m])), 1)) / 0.005)), 0)"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":25},{"color":"green","value":75}]}},"overrides":[]}},

    {"id":70,"title":"Backend Prometheus Target","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":12,"x":0,"y":60},"targets":[{"refId":"A","expr":"up{job=\"yurtlar-backend\"}","legendFormat":"backend"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"values":false}}},
    {"id":71,"title":"Kafka Exporter Target","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":12,"x":12,"y":60},"targets":[{"refId":"A","expr":"up{job=\"kafka-exporter\"}","legendFormat":"kafka-exporter"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"values":false}}}
